# Spotify OAuth
CLIENT_ID=your-spotify-client-id
CLIENT_SECRET=your-spotify-client-secret
# Base origin only; the backend appends /api/auth/callback.
REDIRECT_URI=http://127.0.0.1:8080
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Database (MySQL/MariaDB)
DATABASE_CONNECTION_STRING=Server=localhost;Port=3306;Database=tracksbypopularity;User=root;Password=password;
MIGRATE_ON_STARTUP=false

# Redis/Valkey
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USE_SSL=false
